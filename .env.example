# Signalera — example environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ─── Supabase ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Durable rate limiting (Upstash Redis REST) ──────────────────────────
# Backs the fixed-window limiter on the auth entry points (OAuth callback and
# /api/waitlist/register). When BOTH are set, the per-IP counter is shared
# across every serverless instance instead of living in a per-instance Map.
# If BOTH are absent, the limiter falls back to in-memory (undurable) and logs
# a warning once, so local dev and previews still work. If they are set but the
# store is unreachable, the limiter FAILS OPEN (allows the request) and logs
# loudly, so a Redis outage never locks users out of sign-in.
# Create a free database at https://console.upstash.com and copy the REST creds.
# Set BOTH in Vercel for Production AND Preview.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Email sending via Resend (required for brief send-email feature) ───
# If RESEND_API_KEY is unset, /api/brief/send-email returns 503 and the
# "Send to myself / others" menu items fail gracefully. PDF export still works.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=briefs@signalera.com

# ─── PDF Export (Puppeteer) ──────────────────────────────────────────────
# Public site URL — used by /api/brief/export-pdf to build the print URL
# Puppeteer navigates to. Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=
# Optional HMAC secret for /print/[id] tokens. If unset, falls back to
# SUPABASE_SERVICE_ROLE_KEY. Both cases are auto-rotated on secret
# rotation — no migration needed.
PDF_PRINT_SECRET=
# Local dev: point at your Chrome binary if it's not in the default
# macOS location. On prod we use @sparticuz/chromium-min and fetch the
# binary from GitHub at cold-start; no env required, but you can
# override the tarball URL (recommended — GH is slow from some regions).
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# PUPPETEER_CHROMIUM_PACK_URL=https://cdn.example.com/chromium-v147.0.2-pack.x64.tar

# ___ ArticlesTab read-only fallback (ships dark) _________________________
# When "true", an indexed company whose ArticlesTab has fewer than 3 rows gets
# a read-only two-layer backfill: own-DB text-match articles first, then Exa web
# results (badged "Web"). Writes nothing to articles/companies/mention_count;
# the only persistence is searchWeb's 6-hour web_search_cache row. Default off.
# Requires EXA_API_KEY for the Layer 2 web results to populate.
NEXT_PUBLIC_ARTICLES_WEB_FALLBACK_ENABLED=
# EXA_API_KEY drives both this fallback's Layer 2 and the existing
# /api/companies/web-fallback memo path. Unset = Layer 2 returns empty.
EXA_API_KEY=

# ___ Tagging: fold primary_company into articles.companies[] (dark, backend) ___
# When "true", the ingest store path adds the article's primary_company to its
# companies[] match field (only when that name resolves to an already-indexed
# company and is not already present). This fixes indexed companies that look
# empty because the Wikidata gate dropped their name (for example Snowflake).
# It widens the companies[] MATCH FIELD ONLY: it never writes company_mentions
# and never increments mention_count, so the longitudinal trend/attention signals
# are frozen. Default off; behavior is byte-identical to today when unset.
# Go-forward only (affects new ingests); no backfill of existing rows.
TAGGING_PRIMARY_FOLD_ENABLED=
